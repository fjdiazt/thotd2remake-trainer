<UserControl x:Class="Hotd2RemakeTrainer.Presentation.Hotd2TrainerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#151A1B"
             Loaded="Panel_Loaded">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#697476" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="39" />
            <Setter Property="Foreground" Value="#EDF1F1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="Track" Grid.Column="1" Width="43" Height="22" CornerRadius="11" Background="#343C3D">
                                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" Margin="3" HorizontalAlignment="Left" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#202728" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#111516" />
                                <Setter TargetName="Track" Property="Background" Value="#54D66A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Row" Property="Background" Value="#1B2520" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDE2E3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Foreground" Value="#E7ECEC" />
            <Setter Property="Background" Value="#252C2D" />
            <Setter Property="BorderBrush" Value="#343D3E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C3831" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#54D66A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1C251F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RateButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#54D66A" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,22,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="GAMEPLAY CHEATS" Style="{StaticResource SectionLabel}" Margin="12,0,0,10" />
            <Border Grid.Row="1" Height="1" Background="#2B3233" Margin="0,0,0,5" />

            <StackPanel Grid.Row="2">
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="INFINITE HEALTH" Tag="health" IsChecked="{Binding InfiniteHealth, Mode=OneWay}" Click="Gameplay_Click" />
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="INFINITE AMMO" Tag="ammo" IsChecked="{Binding InfiniteAmmo, Mode=OneWay}" Click="Gameplay_Click" />
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="INFINITE CONTINUES" Tag="continues" IsChecked="{Binding InfiniteContinues, Mode=OneWay}" Click="Gameplay_Click" />
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="ONE SHOT MODE" Tag="one-shot" IsChecked="{Binding OneShot, Mode=OneWay}" Click="Gameplay_Click" />
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="EASY BOSS MODE" Tag="easy-boss" IsChecked="{Binding EasyBoss, Mode=OneWay}" Click="Gameplay_Click" />
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="ZERO DAMAGE" Tag="zero-damage" IsChecked="{Binding ZeroDamage, Mode=OneWay}" Click="Gameplay_Click" />
                <ToggleButton Style="{StaticResource SwitchStyle}" Content="ALL WEAPONS UNLOCKED" Tag="all-weapons" IsChecked="{Binding AllWeapons, Mode=OneWay}" Click="Gameplay_Click" />
            </StackPanel>

            <Border Grid.Row="3" Background="#171D1E" BorderBrush="#2B3334" BorderThickness="1" CornerRadius="6" Margin="0,14,0,10" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="FIRE MODE" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="FireMode" Content="OFF" Tag="off" Style="{StaticResource RadioStyle}" IsChecked="{Binding IsFireOff, Mode=OneWay}" Checked="FireMode_Checked" />
                        <RadioButton GroupName="FireMode" Content="AUTO" Tag="auto" Style="{StaticResource RadioStyle}" IsChecked="{Binding IsAutoFire, Mode=OneWay}" Checked="FireMode_Checked" />
                        <RadioButton GroupName="FireMode" Content="RAPID" Tag="rapid" Style="{StaticResource RadioStyle}" IsChecked="{Binding IsRapidFire, Mode=OneWay}" Checked="FireMode_Checked" />
                    </StackPanel>
                    <Grid Margin="0,11,0,0" IsEnabled="{Binding IsRapidFire}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SHOTS PER SECOND" Foreground="#7F898B" FontSize="10" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource RateButtonStyle}" Content="−" Click="RateDown_Click" />
                            <Border Width="40" Height="28" Background="#111516" BorderBrush="#343D3E" BorderThickness="1">
                                <TextBlock Text="{Binding RapidFireRate}" Foreground="#54D66A" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource RateButtonStyle}" Content="+" Click="RateUp_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ToggleButton Grid.Row="4" Style="{StaticResource SwitchStyle}" Content="REMEMBER CHEATS ACROSS GAME RESTARTS" Tag="persist" IsChecked="{Binding Persist, Mode=OneWay}" Click="Gameplay_Click" />
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="PROGRESSION UNLOCKS" Style="{StaticResource SectionLabel}" Margin="12,0,0,10" />
            <Border Grid.Row="1" Height="1" Background="#2B3233" Margin="0,0,0,14" />
            <Border Grid.Row="2" Background="#251F1B" BorderBrush="#594334" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,14">
                <TextBlock Text="These actions modify save progress and cannot be undone." Foreground="#CDB7A8" FontSize="10" TextWrapping="Wrap" />
            </Border>

            <UniformGrid Grid.Row="3" Columns="2" Rows="4" IsEnabled="{Binding ActionsEnabled}">
                <Button Style="{StaticResource ActionButtonStyle}" Content="ALL CHAPTERS" Tag="13" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="BESTIARY" Tag="15" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="TRAINING MODES" Tag="7" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="TRAINING + STARS" Tag="18" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="BOSS MODES" Tag="11" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="BOSS + STARS" Tag="17" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="ALL TRUNK ITEMS" Tag="9" Click="Action_Click" />
                <Button Style="{StaticResource ActionButtonStyle}" Content="ALL ACHIEVEMENTS" Tag="16" Click="Action_Click" />
            </UniformGrid>

            <Border Grid.Row="4" Background="#121718" CornerRadius="5" Padding="12,10" Margin="0,14,0,0">
                <TextBlock Text="{Binding ActionStatus}" Foreground="#7F898B" FontSize="10" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
