[ENABLE]

aobscan(INFAMMO,FF C8 89 87 D4 00 00 00 48) // should be unique
alloc(newmem,$1000,INFAMMO)

label(code)
label(return)

newmem:

code:
  //dec eax
  mov eax,[rdi+000000A4]
  mov [rdi+000000D4],eax
  jmp return

INFAMMO:
  jmp newmem
  nop 3
return:
registersymbol(INFAMMO)

[DISABLE]

INFAMMO:
  db FF C8 89 87 D4 00 00 00

unregistersymbol(INFAMMO)
dealloc(newmem)


</AssemblerScript>
