[ENABLE]

aobscan(PLAYER_PTR,41 FF D3 48 8B C8 83 38 00 48 8D 64 24 00 49 BB ?? ?? ?? ?? ?? ?? ?? ?? 41 FF D3 85 C0 75 02 FF C6 FF C7) // should be unique
alloc(newmem,$1000,PLAYER_PTR)

label(code)
label(return)

newmem:

code:
  call r11
  mov rcx,rax
  mov [player],rax
  jmp return

PLAYER_PTR:
  jmp newmem
  nop

player:
  dq 0

return:
registersymbol(PLAYER_PTR)
registersymbol(player)
[DISABLE]

PLAYER_PTR:
  db 41 FF D3 48 8B C8

unregistersymbol(*)
dealloc(*)


</AssemblerScript>
    </CheatEntry>
