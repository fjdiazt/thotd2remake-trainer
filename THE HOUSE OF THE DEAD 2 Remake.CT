[ENABLE]

aobscan(OHK,F2 0F 5C C1 F2 0F 5A E8 F3 0F 11 6F 64) // should be unique
alloc(newmem,$1000,OHK)

label(code)
label(return)

newmem:
  push rsi
  push rdx
  mov rsi,[player]
  mov rdx,[rsi+40]
  cmp rdx,rdi
  je code
  subsd xmm0,xmm0
  cvtsd2ss xmm5,xmm0
  jmp return
  pop rsi
  pop rdx

code:
  pop rsi
  pop rdx
  subsd xmm0,xmm1
  cvtsd2ss xmm5,xmm0
  jmp return

OHK:
  jmp newmem
  nop 3
return:
registersymbol(OHK)

[DISABLE]

OHK:
  db F2 0F 5C C1 F2 0F 5A E8

unregistersymbol(OHK)
dealloc(newmem)


</AssemblerScript>
